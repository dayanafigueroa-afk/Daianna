# Copia este archivo a .env y completa los valores reales.

DATABASE_URL="postgresql://usuario:password@localhost:5432/jop360?schema=public"

# Secreto para firmar la sesión (JWT). Generar uno real y largo en producción,
# por ejemplo con: openssl rand -base64 48
AUTH_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la app (usada para armar enlaces en correos, ej. reset de contraseña)
APP_URL="http://localhost:3000"

# Contraseña que se asigna a todas las cuentas creadas por el seed inicial
# (usuarios deben cambiarla en su primer ingreso).
SEED_DEFAULT_PASSWORD="Assetplan2026!"

# Cuenta que el seed promueve a Administrador (no viene del Archivo Madre,
# que no trae ningún usuario con ese rol).
ADMIN_EMAIL="admin@assetplan.cl"
ADMIN_NAME="Administrador JOP 360"

# Directorio local de adjuntos (fallback de desarrollo; en producción usar S3/Azure Blob).
UPLOAD_DIR="./storage/uploads"

# Dejar vacío en este entorno: no hay SMTP corporativo configurado, así que
# las notificaciones por correo solo quedan registradas en logs (ver
# src/lib/notifications/email-channel.ts).
SMTP_HOST=""
